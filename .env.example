# Set these in Vercel → website project → Settings → Environment Variables, then redeploy.

# Where published content is read from: the backend project (villacavo-backend).
# Locally it defaults to http://localhost:5175/api/content (the backend's dev server).
VITE_CONTENT_URL=https://your-backend.vercel.app/api/content

# Address of the admin panel (villacavo-admin), so its Preview button can show unpublished drafts.
# Locally it defaults to http://localhost:5174
VITE_ADMIN_URL=https://your-admin.vercel.app
